{
  "name": "lingonberry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.11.1",
    "npm": ">=12.2.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs && node scripts/shell-assets.mjs --check",
