    "shell:sync": "node scripts/shell-assets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:somnio-kimm/lingonberry.git"
  },
  "devDependencies": {
    "playwright": "1.64.0"
  },
  "packageManager": "npm@12.2.0"
}
